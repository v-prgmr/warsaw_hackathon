<?xml version="1.0" encoding="UTF-8"?>
<!-- Host-side CycloneDDS config: bind DDS to the Ethernet NIC facing the G1 (192.168.123.0/24). -->
<CycloneDDS xmlns="https://cdds.io/config">
  <Domain Id="any">
    <General>
      <Interfaces>
        <NetworkInterface name="${ROBOT_IFACE}" priority="default" multicast="default"/>
      </Interfaces>
    </General>
  </Domain>
</CycloneDDS>
