<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>g1_calibration</name>
  <version>0.0.1</version>
  <description>Chessboard calibration of the chest-mounted OAK-D: intrinsics (checked against the
  factory values), OAK-D to head RealSense, and OAK-D to MID-360 LiDAR (board planes), with the
  two OAK-to-LiDAR paths cross-checked. Read-only towards the robot.</description>
  <maintainer email="jgilaviles@gmail.com">jgilaviles</maintainer>
  <license>BSD-3-Clause</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>tf2_ros_py</exec_depend>
  <exec_depend>cv_bridge</exec_depend>
  <exec_depend>rqt_image_view</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-yaml</exec_depend>

  <test_depend>ament_flake8</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
