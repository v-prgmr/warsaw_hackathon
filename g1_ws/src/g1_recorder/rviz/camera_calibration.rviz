Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Image
      Name: RealSense shared ChArUco corners
      Enabled: true
      Topic:
        Value: /g1_calibration/realsense/charuco_overlay
        Reliability Policy: Reliable
        Durability Policy: Volatile
      Transport Hint: raw
    - Class: rviz_default_plugins/Image
      Name: OAK-D shared ChArUco corners
      Enabled: true
      Topic:
        Value: /g1_calibration/oak/charuco_overlay
        Reliability Policy: Reliable
        Durability Policy: Volatile
      Transport Hint: raw
  Global Options:
    Fixed Frame: camera_color_optical_frame
    Background Color: 48; 48; 48
  Tools:
    - Class: rviz_default_plugins/MoveCamera
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Name: Current View
Window Geometry:
  Height: 900
  Width: 1500
