<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>g1_sensors</name>
  <version>0.0.1</version>
  <description>The G1's /tf chain (AGENTS.md §10.1): /lowstate -> /joint_states bridge,
  robot_state_publisher with the G1 29-DoF rev 1.0 URDF, and static glue frames for the sensor
  drivers. Read-only towards the robot.</description>
  <maintainer email="stanislawix@gmail.com">stanislawix</maintainer>
  <license>BSD-3-Clause</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>unitree_hg</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-yaml</exec_depend>

  <test_depend>ament_flake8</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
