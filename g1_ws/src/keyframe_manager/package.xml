<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>keyframe_manager</name>
  <version>0.0.1</version>
  <description>Selects ~8-20 RGB-D keyframes (sharp, spatially diverse, temporally spaced) from the
  live stream or a replayed bag, and writes them in the frozen keyframe struct (rgb.png, depth.npy,
  camera_info.yaml, meta.yaml + manifest.json) for semantic queries and offline fixtures.</description>
  <maintainer email="inko.inkreate@gmail.com">inko</maintainer>
  <license>BSD-3-Clause</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>message_filters</exec_depend>
  <exec_depend>cv_bridge</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-yaml</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
